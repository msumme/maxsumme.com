---
import type { CollectionEntry } from 'astro:content';
import { postUrl } from '../lib/paths';
import { excerpt } from '../lib/excerpt';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const url = postUrl(post);
const date = post.data.pubDate.toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC',
});
---

<article class="post-preview">
  <h2 class="post-preview-title"><a href={url}>{post.data.title}</a></h2>
  <p class="post-meta"><time datetime={post.data.pubDate.toISOString()}>{date}</time></p>
  <p class="post-preview-excerpt">{excerpt(post.body ?? '')}</p>
  <p class="post-preview-more"><a href={url}>Continue reading →</a></p>
</article>

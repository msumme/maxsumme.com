---
import '../styles/site.css';

interface Props {
  title: string;
  description?: string;
}

const siteName = 'Max Summe';
const tagline = 'On Building Software with Teams';
const { title, description = `${siteName} | ${tagline}` } = Astro.props;
const fullTitle = title === siteName ? `${siteName} | ${tagline}` : `${title} · ${siteName}`;
const path = Astro.url.pathname;
const navItems = [
  { href: '/', label: 'Home' },
  { href: '/contact-me/', label: 'Contact' },
  { href: '/about/', label: 'About' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={siteName} href="/rss.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cinzel&family=Lora:ital,wght@0,400;0,700;1,400;1,700&family=Lustria&display=swap"
    />
    <title>{fullTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="site-name" href="/">{siteName}</a>
      <p class="site-tagline">{tagline}</p>
      <nav class="site-nav">
        {navItems.map((item) => (
          <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>{item.label}</a>
        ))}
      </nav>
    </header>
    <main class="site-main">
      <slot />
    </main>
    <footer class="site-footer">
      <span>© {new Date().getFullYear()} Max Summe</span>
      <a href="/rss.xml">RSS</a>
    </footer>
  </body>
</html>

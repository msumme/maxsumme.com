---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { postPath } from '../../../../lib/paths';

export async function getStaticPaths() {
  const includeDrafts = import.meta.env.DEV;
  const posts = await getCollection('posts', ({ data }) => includeDrafts || !data.draft);
  return posts.map((entry) => ({ params: postPath(entry), props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const formatDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---

<BaseLayout title={entry.data.title}>
  <article class="prose">
    <h1>{entry.data.title}</h1>
    <p class="post-meta">
      <time datetime={entry.data.pubDate.toISOString()}>{formatDate(entry.data.pubDate)}</time>
      {entry.data.draft && <span> · DRAFT</span>}
    </p>
    <Content />
  </article>
</BaseLayout>
